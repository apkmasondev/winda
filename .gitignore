# Only application files and publication inputs belong in Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/src/
!/tests/
!/public/
!/tools/
/tools/*
!/tools/check-repository.mjs
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml

# Only the runtime assets, never original production material.
/public/**
!/public/audio/
!/public/audio/sfx/
!/public/audio/manifest.json
!/public/audio/hall.m4a
!/public/audio/stepwell.m4a
!/public/audio/summit.m4a
!/public/audio/sfx/bottom.m4a
!/public/audio/sfx/stop.m4a
!/public/models/
!/public/models/arch.glb
!/public/models/cabin.glb
!/public/models/stepwell.glb
!/public/textures/
!/public/textures/stone_detail.jpg
!/public/textures/stone_normal.jpg
!/public/video/
!/public/video/intro.mp4

# Credentials, machine settings and temporary files.
**/.env
**/.env.*
**/.npmrc
**/.netrc
**/.gitconfig
**/.aws/
**/.ssh/
**/.claude/
**/.codex/
**/.agents/
**/.vscode/
**/.idea/
**/node_modules/
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*credentials*
**/*secret*
**/*.local.*
**/*.log
**/*.bak
**/*.zip
**/.DS_Store
**/Thumbs.db
